# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit it.
# Get real values from the Supabase dashboard (see comments below).

# --- Supabase: Postgres connection (server-side, for Knex) ---
# Where to find it:
#   Supabase dashboard → Connect (green button, top of project) → ORMs → Knex
#   OR Connect → Direct connection → URI
# Replace [YOUR-PASSWORD] in the URL with your real database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# --- Supabase: Project URL + anon key (used by the Supabase JS client) ---
# Where: Project Settings (gear) → API
# anon key is safe to expose to the browser; it's scoped by Row Level Security.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# --- Supabase: service_role key (SERVER ONLY — NEVER ship to the browser) ---
# Where: Project Settings → API → service_role
# This key bypasses Row Level Security. Treat it like a root password.
# Leave blank for now if you're not using it yet.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub Personal Access Token (server-side, for Octokit) ---
# Where: github.com → Settings → Developer settings → Personal access tokens
# Used by the sync script to pull project data into Supabase.
# Leave blank until we wire the GitHub sync.
GITHUB_TOKEN=

# --- Anthropic API key (server-side, for AI README summaries) ---
# Where: console.anthropic.com → API Keys
# Used for the "Explain this project" button.
# Leave blank until we wire the AI feature.
ANTHROPIC_API_KEY=
